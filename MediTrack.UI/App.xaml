<Application x:Class="MediTrack.UI.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:MediTrack.UI.ViewModels"
             xmlns:v="clr-namespace:MediTrack.UI.Views"
             xmlns:conv="clr-namespace:MediTrack.UI.Converters">
    <Application.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        <conv:InvertedBooleanToVisibilityConverter x:Key="InvertedBooleanToVisibilityConverter" />
        <conv:EqualityToBrushConverter x:Key="EqualityToBrushConverter" />
        <conv:EqualityToForegroundConverter x:Key="EqualityToForegroundConverter" />

        <DataTemplate DataType="{x:Type vm:SplashViewModel}">
            <v:SplashView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:LoginViewModel}">
            <v:LoginView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:DashboardViewModel}">
            <v:DashboardView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:MyMedicinesViewModel}">
            <v:MyMedicinesView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ScheduleViewModel}">
            <v:ScheduleView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:RemindersViewModel}">
            <v:RemindersView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:HistoryViewModel}">
            <v:HistoryView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:SettingsViewModel}">
            <v:SettingsView />
        </DataTemplate>
    </Application.Resources>
</Application>
