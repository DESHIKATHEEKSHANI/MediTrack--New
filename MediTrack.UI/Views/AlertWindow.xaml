<Window x:Class="MediTrack.UI.Views.AlertWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="380" Height="220"
        WindowStartupLocation="Manual"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        Background="#263238">
    <Border Padding="20" CornerRadius="8">
        <StackPanel>
            <TextBlock Text="Medication Reminder" FontSize="16" FontWeight="Bold" Foreground="White" />
            <TextBlock Text="{Binding MedicationName}" FontSize="16" Foreground="#FFEB3B" Margin="0,8,0,4" TextWrapping="Wrap" />
            <TextBlock Text="{Binding DosageInfo}" FontSize="14" Foreground="#B0BEC5" Margin="0,0,0,12" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <Button Content="Taken" Command="{Binding TakenCommand}" Background="#4CAF50" Foreground="White" Padding="16,8" Margin="0,0,8,0" />
                <Button Content="Snooze" Command="{Binding SnoozeCommand}" Background="#2196F3" Foreground="White" Padding="16,8" Margin="0,0,8,0" />
                <Button Content="Missed" Command="{Binding MissedCommand}" Background="#FF9800" Foreground="White" Padding="16,8" />
            </StackPanel>
            <TextBlock Text="{Binding SnoozeMinutes, StringFormat='Snooze for {0} min'}" FontSize="11" Foreground="#90A4AE" HorizontalAlignment="Center" Margin="0,4,0,0" />
        </StackPanel>
    </Border>
</Window>
