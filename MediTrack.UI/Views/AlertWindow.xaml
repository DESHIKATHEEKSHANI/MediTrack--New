<Window x:Class="MediTrack.UI.Views.AlertWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:MediTrack.UI.ViewModels"
        Width="360" Height="200"
        WindowStartupLocation="Manual"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        Background="#263238">
    <Window.DataContext>
        <vm:AlertViewModel />
    </Window.DataContext>
    <Border Padding="20" CornerRadius="8">
        <StackPanel>
            <TextBlock Text="Medication Reminder" FontSize="16" FontWeight="Bold" Foreground="White" />
            <TextBlock Text="{Binding MedicationName}" FontSize="18" Foreground="#FFEB3B" Margin="0,8,0,4" />
            <TextBlock Text="{Binding DosageInfo}" FontSize="14" Foreground="#B0BEC5" Margin="0,0,0,16" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <Button Content="Taken" Command="{Binding TakenCommand}" Background="#4CAF50" Foreground="White" Padding="20,8" Margin="0,0,12,0" />
                <Button Content="Dismiss" Command="{Binding DismissCommand}" Background="#FF9800" Foreground="White" Padding="20,8" />
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
