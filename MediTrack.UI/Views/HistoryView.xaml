<UserControl x:Class="MediTrack.UI.Views.HistoryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:MediTrack.UI.ViewModels"
             xmlns:conv="clr-namespace:MediTrack.UI.Converters"
             xmlns:models="clr-namespace:MediTrack.UI.Models"
             xmlns:core="clr-namespace:MediTrack.Core.Models;assembly=MediTrack.Core">
    <UserControl.Resources>
        <conv:StringToVisibilityConverter x:Key="StringToVisibilityConverter" />
        <Style x:Key="NavItemStyle" TargetType="Border">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Padding" Value="16,10" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Cursor" Value="Hand" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                    <Setter Property="Background" Value="#1565C0" />
                </DataTrigger>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#1565C0" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="FilterButtonStyle" TargetType="Button">
            <Setter Property="Padding" Value="12,6" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="16" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#888888" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#E3F2FD" />
                    <Setter Property="Foreground" Value="#104C7F" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="240" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Sidebar -->
        <Grid Grid.Column="0" Background="#104C7F">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Margin="24,24,24,16" Orientation="Horizontal">
                <Image Source="/Assets/logo-meditrack.png" Width="40" Height="40" Margin="0,0,10,0" VerticalAlignment="Top" />
                <StackPanel>
                    <TextBlock Text="MediTrack" FontSize="24" FontWeight="Bold" Foreground="White" />
                    <TextBlock Text="Reminder" FontSize="14" Foreground="#90CAF9" />
                </StackPanel>
            </StackPanel>

            <ListBox Grid.Row="1" ItemsSource="{Binding NavItems}" SelectedItem="{Binding SelectedNavItem}" Background="Transparent" BorderThickness="0" Margin="12,0">
                <ListBox.ItemTemplate>
                    <DataTemplate DataType="{x:Type models:NavItem}">
                        <Border Style="{StaticResource NavItemStyle}">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{Binding Icon}" Fill="White" Width="16" Height="16" Stretch="Uniform" Margin="0,0,12,0" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding Label}" Foreground="White" FontSize="14" VerticalAlignment="Center" />
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <Border Grid.Row="2" Background="#0D3A66" Padding="16" Margin="12,0,12,12" CornerRadius="8">
                <StackPanel>
                    <TextBlock Text="{Binding WelcomeMessage}" FontSize="12" Foreground="#BBDEFB" TextTrimming="CharacterEllipsis" />
                    <Button Command="{Binding LogoutCommand}" Background="Transparent" Foreground="White" FontSize="12" HorizontalAlignment="Left" Padding="0" Margin="0,4,0,0" BorderThickness="0">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="M17,7L15.59,8.41L18.17,11H8V13H18.17L15.59,15.58L17,17L22,12M12,2A10,10 0 0,0 2,12A10,10 0 0,0 12,22A10,10 0 0,0 22,12V20H20V12A8,8 0 0,1 12,4A8,8 0 0,1 20,12V18H18V12A6,6 0 0,0 12,6A6,6 0 0,0 6,12V18H4V12A8,8 0 0,1 12,4" Fill="White" Width="14" Height="14" Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center" />
                            <TextBlock Text="Logout" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Main Content -->
        <Grid Grid.Column="1" Background="#F8F9FA">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Top Bar -->
            <Border Grid.Row="0" Background="White" Padding="24,16" Margin="0,0,0,1">
                <Border.Effect>
                    <DropShadowEffect ShadowDepth="0" BlurRadius="4" Opacity="0.06" Color="#000000" />
                </Border.Effect>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <TextBlock Text="Intake History" FontSize="22" FontWeight="Bold" Foreground="#1A1A1A" />
                        <TextBlock Text="{Binding FilteredLogs.Count, StringFormat='{}{0} records found'}" FontSize="13" Foreground="#888888" Margin="0,2,0,0" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Content Area -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="24">
                <StackPanel>
                    <!-- Tab-style Filter Bar -->
                    <Border Background="White" CornerRadius="12" Padding="8" Margin="0,0,0,16">
                        <Border.Effect><DropShadowEffect ShadowDepth="0" BlurRadius="8" Opacity="0.05" Color="#000000" /></Border.Effect>
                        <StackPanel Orientation="Horizontal">
                            <Button Command="{Binding SetFilterCommand}" CommandParameter="All" Padding="16,8" BorderThickness="0" Margin="2">
                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Setter Property="Background" Value="Transparent" />
                                        <Setter Property="Foreground" Value="#888888" />
                                        <Setter Property="FontSize" Value="13" />
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="Button">
                                                    <Border Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                    </Border>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding DataContext.ActiveFilter, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="All">
                                                <Setter Property="Background" Value="#104C7F" />
                                                <Setter Property="Foreground" Value="White" />
                                                <Setter Property="FontWeight" Value="SemiBold" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                                <TextBlock Text="All" />
                            </Button>
                            <Button Command="{Binding SetFilterCommand}" CommandParameter="Taken" Padding="16,8" BorderThickness="0" Margin="2">
                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Setter Property="Background" Value="Transparent" />
                                        <Setter Property="Foreground" Value="#888888" />
                                        <Setter Property="FontSize" Value="13" />
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="Button">
                                                    <Border Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                    </Border>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding DataContext.ActiveFilter, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="Taken">
                                                <Setter Property="Background" Value="#4CAF50" />
                                                <Setter Property="Foreground" Value="White" />
                                                <Setter Property="FontWeight" Value="SemiBold" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse Width="7" Height="7" Fill="#4CAF50" VerticalAlignment="Center" Margin="0,0,6,0">
                                        <Ellipse.Style>
                                            <Style TargetType="Ellipse">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding DataContext.ActiveFilter, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="Taken">
                                                        <Setter Property="Fill" Value="White" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Ellipse.Style>
                                    </Ellipse>
                                    <TextBlock Text="Taken" />
                                </StackPanel>
                            </Button>
                            <Button Command="{Binding SetFilterCommand}" CommandParameter="Missed" Padding="16,8" BorderThickness="0" Margin="2">
                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Setter Property="Background" Value="Transparent" />
                                        <Setter Property="Foreground" Value="#888888" />
                                        <Setter Property="FontSize" Value="13" />
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="Button">
                                                    <Border Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                    </Border>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding DataContext.ActiveFilter, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="Missed">
                                                <Setter Property="Background" Value="#D32F2F" />
                                                <Setter Property="Foreground" Value="White" />
                                                <Setter Property="FontWeight" Value="SemiBold" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse Width="7" Height="7" Fill="#D32F2F" VerticalAlignment="Center" Margin="0,0,6,0">
                                        <Ellipse.Style>
                                            <Style TargetType="Ellipse">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding DataContext.ActiveFilter, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="Missed">
                                                        <Setter Property="Fill" Value="White" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Ellipse.Style>
                                    </Ellipse>
                                    <TextBlock Text="Missed" />
                                </StackPanel>
                            </Button>
                            <Button Command="{Binding SetFilterCommand}" CommandParameter="Pending" Padding="16,8" BorderThickness="0" Margin="2">
                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Setter Property="Background" Value="Transparent" />
                                        <Setter Property="Foreground" Value="#888888" />
                                        <Setter Property="FontSize" Value="13" />
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="Button">
                                                    <Border Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                    </Border>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding DataContext.ActiveFilter, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="Pending">
                                                <Setter Property="Background" Value="#FF9800" />
                                                <Setter Property="Foreground" Value="White" />
                                                <Setter Property="FontWeight" Value="SemiBold" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse Width="7" Height="7" Fill="#FF9800" VerticalAlignment="Center" Margin="0,0,6,0">
                                        <Ellipse.Style>
                                            <Style TargetType="Ellipse">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding DataContext.ActiveFilter, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="Pending">
                                                        <Setter Property="Fill" Value="White" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Ellipse.Style>
                                    </Ellipse>
                                    <TextBlock Text="Pending" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Border>

                    <!-- History Cards -->
                    <Border Background="White" CornerRadius="12" Padding="0,8">
                        <Border.Effect><DropShadowEffect ShadowDepth="0" BlurRadius="12" Opacity="0.06" Color="#000000" /></Border.Effect>
                        <StackPanel>
                            <ItemsControl ItemsSource="{Binding FilteredLogs}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type core:IntakeLog}">
                                        <Border BorderThickness="3,0,0,0" Margin="0,0,0,4" Padding="16,12">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="BorderBrush" Value="#FF9800" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Status}" Value="Taken">
                                                            <Setter Property="BorderBrush" Value="#4CAF50" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Status}" Value="Missed">
                                                            <Setter Property="BorderBrush" Value="#D32F2F" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="2*" />
                                                    <ColumnDefinition Width="1.5*" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="1.4*" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Medication.OfficialName}" FontSize="14" FontWeight="SemiBold" Foreground="#1A1A1A" />
                                                    <TextBlock Text="{Binding Medication.DisplayName}" FontSize="11" Foreground="#AAAAAA" Visibility="{Binding Medication.DisplayName, Converter={StaticResource StringToVisibilityConverter}}" />
                                                </StackPanel>
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding ScheduledDateTime, StringFormat='{}{0:MMM dd}'}" FontSize="12" Foreground="#888888" />
                                                    <TextBlock Text="{Binding ScheduledDateTime, StringFormat='{}{0:hh:mm tt}'}" FontSize="13" FontWeight="SemiBold" Foreground="#1A1A1A" />
                                                </StackPanel>
                                                <Border Grid.Column="2" CornerRadius="12" Padding="10,4" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="0,0,16,0">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Setter Property="Background" Value="#FFF3E0" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Status}" Value="Taken">
                                                                    <Setter Property="Background" Value="#E8F5E9" />
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding Status}" Value="Missed">
                                                                    <Setter Property="Background" Value="#FFEBEE" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <TextBlock FontSize="11" FontWeight="Bold">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Text" Value="⏳ Pending" />
                                                                <Setter Property="Foreground" Value="#E65100" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding Status}" Value="Taken">
                                                                        <Setter Property="Text" Value="✓ Taken" />
                                                                        <Setter Property="Foreground" Value="#2E7D32" />
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding Status}" Value="Missed">
                                                                        <Setter Property="Text" Value="✗ Missed" />
                                                                        <Setter Property="Foreground" Value="#C62828" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </Border>
                                                <StackPanel Grid.Column="3" VerticalAlignment="Center">
                                                    <TextBlock Text="Actioned at" FontSize="11" Foreground="#AAAAAA" />
                                                    <TextBlock FontSize="12" Foreground="#888888">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Text" Value="—" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding ActionTimestamp}" Value="{x:Null}">
                                                                        <Setter Property="Text" Value="—" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                        <TextBlock.Text>
                                                            <Binding Path="ActionTimestamp" StringFormat="{}{0:hh:mm tt}" FallbackValue="—" TargetNullValue="—" />
                                                        </TextBlock.Text>
                                                    </TextBlock>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <StackPanel HorizontalAlignment="Center" Margin="0,32,0,24">
                                <StackPanel.Style>
                                    <Style TargetType="StackPanel">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding FilteredLogs.Count}" Value="0">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </StackPanel.Style>
                                <Path Data="M13 3a9 9 0 0 0-9 9H1l3.89 3.89.07.14L9 12H6c0-3.87 3.13-7 7-7s7 3.13 7 7-3.13 7-7 7c-1.93 0-3.68-.79-4.94-2.06l-1.42 1.42A8.954 8.954 0 0 0 13 21a9 9 0 0 0 0-18z"
                                      Fill="#CCCCCC" Width="36" Height="36" Stretch="Uniform" HorizontalAlignment="Center" Margin="0,0,0,12" />
                                <TextBlock Text="No records found" FontSize="15" FontWeight="SemiBold" Foreground="#AAAAAA" HorizontalAlignment="Center" />
                                <TextBlock Text="Try adjusting the filter above" FontSize="12" Foreground="#CCCCCC" HorizontalAlignment="Center" Margin="0,4,0,0" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>
