<UserControl x:Class="MediTrack.UI.Views.MyMedicinesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:MediTrack.UI.ViewModels"
             xmlns:conv="clr-namespace:MediTrack.UI.Converters"
             xmlns:models="clr-namespace:MediTrack.UI.Models"
             xmlns:core="clr-namespace:MediTrack.Core.Models;assembly=MediTrack.Core">
    <UserControl.Resources>
        <conv:StringToVisibilityConverter x:Key="StringToVisibilityConverter" />
        <Style x:Key="NavItemStyle" TargetType="Border">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Padding" Value="16,10" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Cursor" Value="Hand" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                    <Setter Property="Background" Value="#1565C0" />
                </DataTrigger>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#1565C0" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="FilterButtonStyle" TargetType="Button">
            <Setter Property="Padding" Value="12,6" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="16" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="Background">
                <Setter.Value>
                    <MultiBinding Converter="{StaticResource EqualityToBrushConverter}">
                        <Binding Path="Tag" RelativeSource="{RelativeSource Self}" />
                        <Binding Path="DataContext.ActiveFilter" RelativeSource="{RelativeSource AncestorType=UserControl}" />
                    </MultiBinding>
                </Setter.Value>
            </Setter>
            <Setter Property="Foreground">
                <Setter.Value>
                    <MultiBinding Converter="{StaticResource EqualityToForegroundConverter}">
                        <Binding Path="Tag" RelativeSource="{RelativeSource Self}" />
                        <Binding Path="DataContext.ActiveFilter" RelativeSource="{RelativeSource AncestorType=UserControl}" />
                    </MultiBinding>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="StatusBadgeStyle" TargetType="Border">
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Padding" Value="8,3" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="HorizontalAlignment" Value="Center" />
        </Style>
    </UserControl.Resources>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="240" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Sidebar -->
        <Grid Grid.Column="0" Background="#104C7F">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Margin="24,24,24,16" Orientation="Horizontal">
                <Image Source="/Assets/logo-meditrack.png" Width="40" Height="40" Margin="0,0,10,0" VerticalAlignment="Top" />
                <StackPanel>
                    <TextBlock Text="MediTrack" FontSize="24" FontWeight="Bold" Foreground="White" />
                    <TextBlock Text="Reminder" FontSize="14" Foreground="#90CAF9" />
                </StackPanel>
            </StackPanel>

            <ListBox Grid.Row="1" ItemsSource="{Binding NavItems}" SelectedItem="{Binding SelectedNavItem}" Background="Transparent" BorderThickness="0" Margin="12,0">
                <ListBox.ItemTemplate>
                    <DataTemplate DataType="{x:Type models:NavItem}">
                        <Border Style="{StaticResource NavItemStyle}">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="8" Height="8" Fill="White" Margin="0,0,12,0" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding Label}" Foreground="White" FontSize="14" VerticalAlignment="Center" />
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <Border Grid.Row="2" Background="#0D3A66" Padding="16" Margin="12,0,12,12" CornerRadius="8">
                <StackPanel>
                    <TextBlock Text="{Binding WelcomeMessage}" FontSize="12" Foreground="#BBDEFB" TextTrimming="CharacterEllipsis" />
                    <Button Command="{Binding LogoutCommand}" Background="Transparent" Foreground="White" FontSize="12" HorizontalAlignment="Left" Padding="0" Margin="0,4,0,0" BorderThickness="0">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="M17,7L15.59,8.41L18.17,11H8V13H18.17L15.59,15.58L17,17L22,12M12,2A10,10 0 0,0 2,12A10,10 0 0,0 12,22A10,10 0 0,0 22,12V20H20V12A8,8 0 0,1 12,4A8,8 0 0,1 20,12V18H18V12A6,6 0 0,0 12,6A6,6 0 0,0 6,12V18H4V12A8,8 0 0,1 12,4" Fill="White" Width="14" Height="14" Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center" />
                            <TextBlock Text="Logout" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Main Content -->
        <Grid Grid.Column="1" Background="#F8F9FA">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Top Bar -->
            <Border Grid.Row="0" Background="White" Padding="24,16" Margin="0,0,0,1">
                <Border.Effect>
                    <DropShadowEffect ShadowDepth="0" BlurRadius="4" Opacity="0.06" Color="#000000" />
                </Border.Effect>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="My Medicines" FontSize="22" FontWeight="Bold" Foreground="#1A1A1A" VerticalAlignment="Center" />
                    <Button Grid.Column="1" Content="+ Add Medicine" Command="{Binding ShowAddMedicineCommand}" Background="#104C7F" Foreground="White" Padding="14,10" FontWeight="SemiBold" BorderThickness="0">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </Grid>
            </Border>

            <!-- Content Area -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="24">
                <StackPanel>
                    <!-- Search & Filters -->
                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Background="White" CornerRadius="8" Padding="12,8" Margin="0,0,12,0">
                            <Border.Effect><DropShadowEffect ShadowDepth="0" BlurRadius="8" Opacity="0.04" Color="#000000" /></Border.Effect>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="&#x1F50D;" FontSize="14" Foreground="#888888" VerticalAlignment="Center" Margin="0,0,8,0" />
                                <TextBox Grid.Column="1" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" Background="Transparent" BorderThickness="0" Padding="0" FontSize="14" Foreground="#1A1A1A" VerticalAlignment="Center" />
                            </Grid>
                        </Border>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Content="All" Command="{Binding SetFilterCommand}" CommandParameter="All" Tag="All" Style="{StaticResource FilterButtonStyle}" />
                            <Button Content="Active" Command="{Binding SetFilterCommand}" CommandParameter="Active" Tag="Active" Style="{StaticResource FilterButtonStyle}" Margin="8,0,0,0" />
                            <Button Content="Archived" Command="{Binding SetFilterCommand}" CommandParameter="Archived" Tag="Archived" Style="{StaticResource FilterButtonStyle}" Margin="8,0,0,0" />
                        </StackPanel>
                    </Grid>

                    <!-- Medicines List -->
                    <Border Background="White" CornerRadius="12" Padding="0">
                        <Border.Effect><DropShadowEffect ShadowDepth="0" BlurRadius="12" Opacity="0.06" Color="#000000" /></Border.Effect>
                        <StackPanel>
                            <!-- Header Row -->
                            <Border Background="#F5F7FA" Padding="16,12">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="2.2*" />
                                        <ColumnDefinition Width="1.1*" />
                                        <ColumnDefinition Width="1.3*" />
                                        <ColumnDefinition Width="1.1*" />
                                        <ColumnDefinition Width="1.4*" />
                                        <ColumnDefinition Width="1.2*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="MEDICINE NAME" FontSize="11" FontWeight="SemiBold" Foreground="#888888" />
                                    <TextBlock Grid.Column="1" Text="DOSAGE" FontSize="11" FontWeight="SemiBold" Foreground="#888888" HorizontalAlignment="Center" />
                                    <TextBlock Grid.Column="2" Text="FREQUENCY" FontSize="11" FontWeight="SemiBold" Foreground="#888888" HorizontalAlignment="Center" />
                                    <TextBlock Grid.Column="3" Text="MEAL TIMING" FontSize="11" FontWeight="SemiBold" Foreground="#888888" HorizontalAlignment="Center" />
                                    <TextBlock Grid.Column="4" Text="DURATION" FontSize="11" FontWeight="SemiBold" Foreground="#888888" HorizontalAlignment="Center" />
                                    <TextBlock Grid.Column="5" Text="ACTIONS" FontSize="11" FontWeight="SemiBold" Foreground="#888888" HorizontalAlignment="Center" />
                                </Grid>
                            </Border>

                            <!-- Medicine Rows -->
                            <ItemsControl ItemsSource="{Binding FilteredMedicines}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type core:Medication}">
                                        <Border BorderBrush="#F0F0F0" BorderThickness="0,0,0,1" Padding="16,14">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="2.2*" />
                                                    <ColumnDefinition Width="1.1*" />
                                                    <ColumnDefinition Width="1.3*" />
                                                    <ColumnDefinition Width="1.1*" />
                                                    <ColumnDefinition Width="1.4*" />
                                                    <ColumnDefinition Width="1.2*" />
                                                </Grid.ColumnDefinitions>
                                                <!-- Name & Type -->
                                                <StackPanel Grid.Column="0" Orientation="Horizontal">
                                                    <Border Width="36" Height="36" Background="#E3F2FD" CornerRadius="18" VerticalAlignment="Center" Margin="0,0,10,0">
                                                        <TextBlock Text="&#x1F48A;" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                    </Border>
                                                    <StackPanel VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding OfficialName}" FontSize="14" FontWeight="SemiBold" Foreground="#1A1A1A" />
                                                        <Border>
                                                            <Border.Style>
                                                                <Style TargetType="Border" BasedOn="{StaticResource StatusBadgeStyle}">
                                                                    <Setter Property="Background" Value="#E8F5E9" />
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsArchived}" Value="True">
                                                                            <Setter Property="Background" Value="#FFF3E0" />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Border.Style>
                                                            <TextBlock FontSize="10" FontWeight="Bold">
                                                                <TextBlock.Style>
                                                                    <Style TargetType="TextBlock">
                                                                        <Setter Property="Text" Value="Active" />
                                                                        <Setter Property="Foreground" Value="#2E7D32" />
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding IsArchived}" Value="True">
                                                                                <Setter Property="Text" Value="Archived" />
                                                                                <Setter Property="Foreground" Value="#E65100" />
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </TextBlock.Style>
                                                            </TextBlock>
                                                        </Border>
                                                    </StackPanel>
                                                </StackPanel>
                                                <!-- Dosage -->
                                                <TextBlock Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="13" Foreground="#888888">
                                                    <TextBlock.Text>
                                                        <MultiBinding StringFormat="{}{0} {1}">
                                                            <Binding Path="DosageValue" />
                                                            <Binding Path="DosageUnit" />
                                                        </MultiBinding>
                                                    </TextBlock.Text>
                                                </TextBlock>
                                                <!-- Frequency -->
                                                <TextBlock Grid.Column="2" Text="{Binding Frequency}" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="13" Foreground="#888888" />
                                                <!-- Meal Timing -->
                                                <TextBlock Grid.Column="3" Text="{Binding MealTiming}" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="13" Foreground="#888888" />
                                                <!-- Duration -->
                                                <StackPanel Grid.Column="4" VerticalAlignment="Center" HorizontalAlignment="Center">
                                                    <TextBlock FontSize="12" Foreground="#888888">
                                                        <TextBlock.Text>
                                                            <MultiBinding StringFormat="{}{0:MMM dd} - {1:MMM dd, yy}">
                                                                <Binding Path="StartDate" />
                                                                <Binding Path="EndDate" />
                                                            </MultiBinding>
                                                        </TextBlock.Text>
                                                    </TextBlock>
                                                    <TextBlock Text="{Binding RemainingPills, StringFormat={}&#x1F535; {0} pills left}" FontSize="11" Foreground="#4CAF50" HorizontalAlignment="Center">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Visibility" Value="Visible" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding RemainingPills}" Value="{x:Null}">
                                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </StackPanel>
                                                <!-- Actions -->
                                                <StackPanel Grid.Column="5" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                    <Button Content="&#x270F;" Command="{Binding DataContext.ShowEditMedicineCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Background="Transparent" Foreground="#104C7F" FontSize="16" Padding="6" BorderThickness="0" Margin="0,0,4,0" />
                                                    <Button Content="&#x1F6C0;" Command="{Binding DataContext.ToggleArchiveCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Background="Transparent" Foreground="#888888" FontSize="16" Padding="6" BorderThickness="0" />
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- Add/Edit Medicine Overlay -->
            <Grid Grid.RowSpan="2" Background="#AA000000" Visibility="{Binding IsPopupOpen, Converter={StaticResource BooleanToVisibilityConverter}}">
                <Border Background="White" CornerRadius="16" Width="560" Padding="28" HorizontalAlignment="Center" VerticalAlignment="Center" MaxHeight="700">
                    <Border.Effect><DropShadowEffect ShadowDepth="0" BlurRadius="24" Opacity="0.4" Color="#000000" /></Border.Effect>
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <TextBlock FontSize="20" FontWeight="SemiBold" Foreground="#1A1A1A" Margin="0,0,0,20">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Text" Value="Add New Medicine" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsEditing}" Value="True">
                                                <Setter Property="Text" Value="Edit Medicine" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>

                            <!-- Section: Basic Info -->
                            <Border BorderBrush="#E3F2FD" BorderThickness="0,0,0,1" Margin="0,0,0,8">
                                <TextBlock Text="Basic Information" FontSize="13" FontWeight="SemiBold" Foreground="#104C7F" Margin="0,0,0,4" />
                            </Border>
                            <TextBlock Text="Medicine Name *" FontSize="12" Foreground="#555555" FontWeight="Medium" Margin="0,0,0,4" />
                            <TextBox Text="{Binding SelectedMedicine.OfficialName}" Padding="10,8" Background="#F8F9FA" BorderBrush="#E0E0E0" Margin="0,0,0,12" />

                            <TextBlock Text="Display Name (optional)" FontSize="12" Foreground="#555555" FontWeight="Medium" Margin="0,0,0,4" />
                            <TextBox Text="{Binding SelectedMedicine.DisplayName}" Padding="10,8" Background="#F8F9FA" BorderBrush="#E0E0E0" Margin="0,0,0,12" />

                            <TextBlock Text="Medicine Type" FontSize="12" Foreground="#555555" FontWeight="Medium" Margin="0,0,0,4" />
                            <ComboBox ItemsSource="{Binding MedicineTypes}" SelectedItem="{Binding SelectedMedicine.MedicineType}" Padding="8,6" Background="#F8F9FA" BorderBrush="#E0E0E0" Margin="0,0,0,12" />

                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                    <TextBlock Text="Dose Amount *" FontSize="12" Foreground="#555555" FontWeight="Medium" Margin="0,0,0,4" />
                                    <TextBox Text="{Binding SelectedMedicine.DosageValue}" Padding="10,8" Background="#F8F9FA" BorderBrush="#E0E0E0" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                    <TextBlock Text="Dose Unit" FontSize="12" Foreground="#555555" FontWeight="Medium" Margin="0,0,0,4" />
                                    <ComboBox ItemsSource="{Binding DosageUnits}" SelectedItem="{Binding SelectedMedicine.DosageUnit}" Padding="8,6" Background="#F8F9FA" BorderBrush="#E0E0E0" />
                                </StackPanel>
                            </Grid>

                            <!-- Section: Schedule -->
                            <Border BorderBrush="#E3F2FD" BorderThickness="0,0,0,1" Margin="0,12,0,8">
                                <TextBlock Text="Schedule" FontSize="13" FontWeight="SemiBold" Foreground="#104C7F" Margin="0,0,0,4" />
                            </Border>
                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                    <TextBlock Text="Frequency" FontSize="12" Foreground="#555555" FontWeight="Medium" Margin="0,0,0,4" />
                                    <ComboBox ItemsSource="{Binding Frequencies}" SelectedItem="{Binding SelectedMedicine.Frequency}" Padding="8,6" Background="#F8F9FA" BorderBrush="#E0E0E0" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                    <TextBlock Text="Meal Timing" FontSize="12" Foreground="#555555" FontWeight="Medium" Margin="0,0,0,4" />
                                    <ComboBox ItemsSource="{Binding MealTimings}" SelectedItem="{Binding SelectedMedicine.MealTiming}" Padding="8,6" Background="#F8F9FA" BorderBrush="#E0E0E0" />
                                </StackPanel>
                            </Grid>

                            <TextBlock Text="Reminder Times (comma-separated, e.g. 08:00,20:00)" FontSize="12" Foreground="#555555" FontWeight="Medium" Margin="0,0,0,4" />
                            <TextBox Text="{Binding SelectedMedicine.ReminderTimes}" Padding="10,8" Background="#F8F9FA" BorderBrush="#E0E0E0" Margin="0,0,0,12" />

                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                    <TextBlock Text="Start Date *" FontSize="12" Foreground="#555555" FontWeight="Medium" Margin="0,0,0,4" />
                                    <DatePicker SelectedDate="{Binding SelectedMedicine.StartDate}" Padding="8,6" Background="#F8F9FA" BorderBrush="#E0E0E0" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                    <TextBlock Text="End Date" FontSize="12" Foreground="#555555" FontWeight="Medium" Margin="0,0,0,4" />
                                    <DatePicker SelectedDate="{Binding SelectedMedicine.EndDate}" Padding="8,6" Background="#F8F9FA" BorderBrush="#E0E0E0" />
                                </StackPanel>
                            </Grid>

                            <CheckBox Content="Ongoing medication (no end date)" IsChecked="{Binding SelectedMedicine.IsOngoing}" Foreground="#555555" Margin="0,0,0,12" />

                            <!-- Section: Stock & Notes -->
                            <Border BorderBrush="#E3F2FD" BorderThickness="0,0,0,1" Margin="0,12,0,8">
                                <TextBlock Text="Stock &amp; Instructions" FontSize="13" FontWeight="SemiBold" Foreground="#104C7F" Margin="0,0,0,4" />
                            </Border>
                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                    <TextBlock Text="Remaining Pills" FontSize="12" Foreground="#555555" FontWeight="Medium" Margin="0,0,0,4" />
                                    <TextBox Text="{Binding SelectedMedicine.RemainingPills}" Padding="10,8" Background="#F8F9FA" BorderBrush="#E0E0E0" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                    <TextBlock Text="Low Stock Alert At" FontSize="12" Foreground="#555555" FontWeight="Medium" Margin="0,0,0,4" />
                                    <TextBox Text="{Binding SelectedMedicine.LowStockAlertAt}" Padding="10,8" Background="#F8F9FA" BorderBrush="#E0E0E0" />
                                </StackPanel>
                            </Grid>

                            <TextBlock Text="Instructions" FontSize="12" Foreground="#555555" FontWeight="Medium" Margin="0,0,0,4" />
                            <TextBox Text="{Binding SelectedMedicine.IntakeInstructions}" Padding="10,8" Background="#F8F9FA" BorderBrush="#E0E0E0" Margin="0,0,0,20" TextWrapping="Wrap" AcceptsReturn="True" Height="60" />

                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button Content="Cancel" Command="{Binding ClosePopupCommand}" Background="Transparent" Foreground="#666666" Padding="12,8" Margin="0,0,8,0" BorderThickness="0" />
                                <Button Content="Save Medicine" Command="{Binding SaveMedicineCommand}" Background="#104C7F" Foreground="White" Padding="16,8" BorderThickness="0">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
