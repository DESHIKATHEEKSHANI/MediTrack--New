<UserControl x:Class="MediTrack.UI.Views.RemindersView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:MediTrack.UI.ViewModels"
             xmlns:conv="clr-namespace:MediTrack.UI.Converters"
             xmlns:models="clr-namespace:MediTrack.UI.Models"
             xmlns:core="clr-namespace:MediTrack.Core.Models;assembly=MediTrack.Core">
    <UserControl.Resources>
        <conv:StringToVisibilityConverter x:Key="StringToVisibilityConverter" />
        <Style x:Key="NavItemStyle" TargetType="Border">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Padding" Value="16,10" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Cursor" Value="Hand" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                    <Setter Property="Background" Value="#1565C0" />
                </DataTrigger>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#1565C0" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="ActionButton" TargetType="Button">
            <Setter Property="Background" Value="White" />
            <Setter Property="Foreground" Value="#104C7F" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="10,6" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="240" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Sidebar -->
        <Grid Grid.Column="0" Background="#104C7F">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Margin="24,24,24,16" Orientation="Horizontal">
                <Image Source="/Assets/logo-meditrack.png" Width="40" Height="40" Margin="0,0,10,0" VerticalAlignment="Top" />
                <StackPanel>
                    <TextBlock Text="MediTrack" FontSize="24" FontWeight="Bold" Foreground="White" />
                    <TextBlock Text="Reminder" FontSize="14" Foreground="#90CAF9" />
                </StackPanel>
            </StackPanel>

            <ListBox Grid.Row="1" ItemsSource="{Binding NavItems}" SelectedItem="{Binding SelectedNavItem}" Background="Transparent" BorderThickness="0" Margin="12,0">
                <ListBox.ItemTemplate>
                    <DataTemplate DataType="{x:Type models:NavItem}">
                        <Border Style="{StaticResource NavItemStyle}">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{Binding Icon}" Fill="White" Width="16" Height="16" Stretch="Uniform" Margin="0,0,12,0" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding Label}" Foreground="White" FontSize="14" VerticalAlignment="Center" />
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <Border Grid.Row="2" Background="#0D3A66" Padding="16" Margin="12,0,12,12" CornerRadius="8">
                <StackPanel>
                    <TextBlock Text="{Binding WelcomeMessage}" FontSize="12" Foreground="#BBDEFB" TextTrimming="CharacterEllipsis" />
                    <Button Command="{Binding LogoutCommand}" Background="Transparent" Foreground="White" FontSize="12" HorizontalAlignment="Left" Padding="0" Margin="0,4,0,0" BorderThickness="0">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="M17,7L15.59,8.41L18.17,11H8V13H18.17L15.59,15.58L17,17L22,12M12,2A10,10 0 0,0 2,12A10,10 0 0,0 12,22A10,10 0 0,0 22,12V20H20V12A8,8 0 0,1 12,4A8,8 0 0,1 20,12V18H18V12A6,6 0 0,0 12,6A6,6 0 0,0 6,12V18H4V12A8,8 0 0,1 12,4" Fill="White" Width="14" Height="14" Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center" />
                            <TextBlock Text="Logout" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Main Content -->
        <Grid Grid.Column="1" Background="#F8F9FA">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Top Bar -->
            <Border Grid.Row="0" Background="White" Padding="24,16" Margin="0,0,0,1">
                <Border.Effect>
                    <DropShadowEffect ShadowDepth="0" BlurRadius="4" Opacity="0.06" Color="#000000" />
                </Border.Effect>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <TextBlock Text="Reminders" FontSize="22" FontWeight="Bold" Foreground="#1A1A1A" />
                        <TextBlock Text="Manage notification settings and reminder rules" FontSize="13" Foreground="#888888" Margin="0,2,0,0" />
                    </StackPanel>
                    <Button Grid.Column="1" Content="+ Add Reminder" Command="{Binding ShowAddReminderCommand}" Background="#104C7F" Foreground="White" Padding="14,10" FontWeight="SemiBold" BorderThickness="0">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </Grid>
            </Border>

            <!-- Content Area -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="24">
                <StackPanel>
                    <!-- Global Notifications Toggle -->
                    <Border CornerRadius="12" Padding="20" Margin="0,0,0,20">
                        <Border.Effect><DropShadowEffect ShadowDepth="0" BlurRadius="12" Opacity="0.06" Color="#000000" /></Border.Effect>
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="#E8F5E9" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding NotificationsEnabled}" Value="False">
                                        <Setter Property="Background" Value="#FFF8E1" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Width="44" Height="44" CornerRadius="22" Margin="0,0,14,0" VerticalAlignment="Center">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="#4CAF50" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding NotificationsEnabled}" Value="False">
                                                <Setter Property="Background" Value="#FF9800" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <Path Data="M18 16v-5c0-3.07-1.64-5.64-4.5-6.32V4c0-.83-.67-1.5-1.5-1.5s-1.5.67-1.5 1.5v.68C7.63 5.36 6 7.92 6 11v5l-2 2v1h16v-1l-2-2zm-5 0h-2v-2h2v2zm0-4h-2V9h2v3z"
                                      Fill="White" Width="22" Height="22" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock FontSize="15" FontWeight="SemiBold">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Text" Value="Notifications Active" />
                                            <Setter Property="Foreground" Value="#2E7D32" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding NotificationsEnabled}" Value="False">
                                                    <Setter Property="Text" Value="Notifications Paused" />
                                                    <Setter Property="Foreground" Value="#E65100" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <TextBlock FontSize="12" Foreground="#888888" Margin="0,2,0,0">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Text" Value="Reminders will fire at their scheduled times" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding NotificationsEnabled}" Value="False">
                                                    <Setter Property="Text" Value="Toggle on to receive medication reminders" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>
                            <ToggleButton Grid.Column="2" IsChecked="{Binding NotificationsEnabled}" VerticalAlignment="Center">
                                <ToggleButton.Style>
                                    <Style TargetType="ToggleButton">
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="ToggleButton">
                                                    <Border Width="48" Height="26" CornerRadius="13">
                                                        <Border.Style>
                                                            <Style TargetType="Border">
                                                                <Setter Property="Background" Value="#E0E0E0" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsChecked, RelativeSource={RelativeSource AncestorType=ToggleButton}}" Value="True">
                                                                        <Setter Property="Background" Value="#4CAF50" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Border.Style>
                                                        <Ellipse Width="20" Height="20" Fill="White" Margin="3,0">
                                                            <Ellipse.Style>
                                                                <Style TargetType="Ellipse">
                                                                    <Setter Property="HorizontalAlignment" Value="Left" />
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsChecked, RelativeSource={RelativeSource AncestorType=ToggleButton}}" Value="True">
                                                                            <Setter Property="HorizontalAlignment" Value="Right" />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Ellipse.Style>
                                                        </Ellipse>
                                                    </Border>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </ToggleButton.Style>
                            </ToggleButton>
                        </Grid>
                    </Border>

                    <!-- Reminders List -->
                    <Border Background="White" CornerRadius="12" Padding="20">
                        <Border.Effect><DropShadowEffect ShadowDepth="0" BlurRadius="12" Opacity="0.06" Color="#000000" /></Border.Effect>
                        <StackPanel>
                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Reminder Rules" FontSize="16" FontWeight="SemiBold" Foreground="#1A1A1A" />
                                <TextBox Grid.Column="1" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" Width="200" Padding="8,4" Background="#F8F9FA" BorderBrush="#E0E0E0" Margin="0,0,12,0" FontSize="12">
                                    <TextBox.Style>
                                        <Style TargetType="TextBox">
                                            <Setter Property="ToolTip" Value="Search by medicine name, time, or frequency" />
                                        </Style>
                                    </TextBox.Style>
                                </TextBox>
                                <TextBlock Grid.Column="2" Text="{Binding FilteredReminders.Count, StringFormat='{}{0} rules'}" FontSize="12" Foreground="#888888" VerticalAlignment="Center" />
                            </Grid>

                            <ItemsControl ItemsSource="{Binding FilteredReminders}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type models:ReminderSetting}">
                                        <Border Background="#F8F9FA" CornerRadius="8" Padding="16" Margin="0,0,0,10">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>

                                                <!-- Enable Toggle -->
                                                <ToggleButton Grid.Column="0" IsChecked="{Binding IsEnabled}" VerticalAlignment="Center" Margin="0,0,12,0">
                                                    <ToggleButton.Style>
                                                        <Style TargetType="ToggleButton">
                                                            <Setter Property="Template">
                                                                <Setter.Value>
                                                                    <ControlTemplate TargetType="ToggleButton">
                                                                        <Border Width="40" Height="22" CornerRadius="11">
                                                                            <Border.Style>
                                                                                <Style TargetType="Border">
                                                                                    <Setter Property="Background" Value="#E0E0E0" />
                                                                                    <Style.Triggers>
                                                                                        <DataTrigger Binding="{Binding IsChecked, RelativeSource={RelativeSource AncestorType=ToggleButton}}" Value="True">
                                                                                            <Setter Property="Background" Value="#4CAF50" />
                                                                                        </DataTrigger>
                                                                                    </Style.Triggers>
                                                                                </Style>
                                                                            </Border.Style>
                                                                            <Ellipse Width="16" Height="16" Fill="White" Margin="3,0">
                                                                                <Ellipse.Style>
                                                                                    <Style TargetType="Ellipse">
                                                                                        <Setter Property="HorizontalAlignment" Value="Left" />
                                                                                        <Style.Triggers>
                                                                                            <DataTrigger Binding="{Binding IsChecked, RelativeSource={RelativeSource AncestorType=ToggleButton}}" Value="True">
                                                                                                <Setter Property="HorizontalAlignment" Value="Right" />
                                                                                            </DataTrigger>
                                                                                        </Style.Triggers>
                                                                                    </Style>
                                                                                </Ellipse.Style>
                                                                            </Ellipse>
                                                                        </Border>
                                                                    </ControlTemplate>
                                                                </Setter.Value>
                                                            </Setter>
                                                        </Style>
                                                    </ToggleButton.Style>
                                                </ToggleButton>

                                                <!-- Reminder Info -->
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding MedicationName}" FontSize="15" FontWeight="SemiBold" Foreground="#1A1A1A" />
                                                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0" FlowDirection="LeftToRight">
                                                        <!-- Time -->
                                                        <Border Background="#E3F2FD" CornerRadius="4" Padding="6,2" Margin="0,0,5,0">
                                                            <TextBlock Text="{Binding Time}" FontSize="11" Foreground="#104C7F" FontWeight="SemiBold" />
                                                        </Border>
                                                        <!-- Active days from WeekdaySchedule -->
                                                        <Border Background="#E8F5E9" CornerRadius="4" Padding="6,2" Margin="0,0,5,0">
                                                            <TextBlock Text="{Binding ActiveDays}" FontSize="11" Foreground="#2E7D32" FontWeight="SemiBold" />
                                                        </Border>
                                                        <!-- Frequency (how many times per day) -->
                                                        <Border Background="#FFF3E0" CornerRadius="4" Padding="6,2" Margin="0,0,5,0">
                                                            <TextBlock Text="{Binding Frequency}" FontSize="11" Foreground="#E65100" FontWeight="SemiBold" />
                                                        </Border>
                                                        <!-- Snooze -->
                                                        <Border Background="#F3E5F5" CornerRadius="4" Padding="6,2">
                                                            <TextBlock Text="{Binding SnoozeMinutes, StringFormat='Snooze {0}min'}" FontSize="11" Foreground="#7B1FA2" FontWeight="SemiBold" />
                                                        </Border>
                                                    </StackPanel>
                                                </StackPanel>

                                                <!-- Edit -->
                                                <Button Grid.Column="2" Content="&#x270F;" Command="{Binding DataContext.ShowEditReminderCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Background="Transparent" Foreground="#104C7F" FontSize="18" Padding="8" BorderThickness="0" Margin="0,0,4,0" />

                                                <!-- Delete -->
                                                <Button Grid.Column="3" Content="&#x1F5D1;" Command="{Binding DataContext.DeleteReminderCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Background="Transparent" Foreground="#D32F2F" FontSize="18" Padding="8" BorderThickness="0" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <TextBlock Text="No reminders configured. Click + Add Reminder to create one." FontSize="14" Foreground="#888888" HorizontalAlignment="Center" Margin="0,20">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Reminders.Count}" Value="0">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- Add/Edit Reminder Overlay -->
            <Grid Grid.RowSpan="2" Background="#AA000000" Visibility="{Binding IsPopupOpen, Converter={StaticResource BooleanToVisibilityConverter}}">
                <Border Background="White" CornerRadius="16" Width="520" Padding="28" HorizontalAlignment="Center" VerticalAlignment="Center" MaxHeight="700">
                    <Border.Effect><DropShadowEffect ShadowDepth="0" BlurRadius="24" Opacity="0.4" Color="#000000" /></Border.Effect>
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <TextBlock FontSize="20" FontWeight="SemiBold" Foreground="#1A1A1A" Margin="0,0,0,20">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Text" Value="Add Reminder" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsEditing}" Value="True">
                                                <Setter Property="Text" Value="Edit Reminder" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>

                            <TextBlock Text="Medicine *" FontSize="12" Foreground="#555555" FontWeight="Medium" Margin="0,0,0,4" />
                            <ComboBox ItemsSource="{Binding Medications}" SelectedValue="{Binding SelectedMedicationId}" SelectedValuePath="Id" DisplayMemberPath="OfficialName" Padding="8,6" Background="#F8F9FA" BorderBrush="#E0E0E0" Margin="0,0,0,4" />
                            <TextBlock Text="{Binding ValidationErrors[Medication]}" FontSize="11" Foreground="#D32F2F" Margin="0,0,0,12" Visibility="{Binding ValidationErrors[Medication], Converter={StaticResource StringToVisibilityConverter}}" />

                            <TextBlock Text="Reminder Times *" FontSize="12" Foreground="#555555" FontWeight="Medium" Margin="0,0,0,4" />
                            <ItemsControl ItemsSource="{Binding ReminderTimes}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type models:ReminderTimeEntry}">
                                        <Grid Margin="0,0,0,8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <ComboBox Grid.Column="0" ItemsSource="{Binding DataContext.Hours, RelativeSource={RelativeSource AncestorType=UserControl}}" SelectedItem="{Binding Hour}" Padding="8,6" Background="#F8F9FA" BorderBrush="#E0E0E0" Width="70" Margin="0,0,6,0" />
                                            <TextBlock Grid.Column="1" Text=":" FontSize="16" Foreground="#555555" VerticalAlignment="Center" Margin="0,0,6,0" />
                                            <ComboBox Grid.Column="2" ItemsSource="{Binding DataContext.Minutes, RelativeSource={RelativeSource AncestorType=UserControl}}" SelectedItem="{Binding Minute}" Padding="8,6" Background="#F8F9FA" BorderBrush="#E0E0E0" Width="70" Margin="0,0,6,0" />
                                            <ComboBox Grid.Column="3" ItemsSource="{Binding DataContext.AmPmOptions, RelativeSource={RelativeSource AncestorType=UserControl}}" SelectedItem="{Binding AmPm}" Padding="8,6" Background="#F8F9FA" BorderBrush="#E0E0E0" Width="70" Margin="0,0,6,0" />
                                            <Button Grid.Column="4" Content="&#x2715;" Command="{Binding DataContext.RemoveTimeCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Background="Transparent" Foreground="#D32F2F" FontSize="14" Padding="6" BorderThickness="0" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <Button Content="+ Add Time" Command="{Binding AddTimeCommand}" Background="Transparent" Foreground="#104C7F" FontWeight="SemiBold" Padding="0,6" HorizontalAlignment="Left" BorderThickness="0" Margin="0,0,0,12" />
                            <TextBlock Text="{Binding ValidationErrors[Times]}" FontSize="11" Foreground="#D32F2F" Margin="0,0,0,12" Visibility="{Binding ValidationErrors[Times], Converter={StaticResource StringToVisibilityConverter}}" />

                            <TextBlock Text="Snooze Duration (minutes)" FontSize="12" Foreground="#555555" FontWeight="Medium" Margin="0,0,0,4" />
                            <ComboBox ItemsSource="{Binding SnoozeOptions}" SelectedItem="{Binding SelectedSnoozeMinutes}" Padding="8,6" Background="#F8F9FA" BorderBrush="#E0E0E0" Margin="0,0,0,16" />

                            <!-- Active Days -->
                            <TextBlock Text="Active Days *" FontSize="12" Foreground="#555555" FontWeight="Medium" Margin="0,0,0,8" />
                            <ItemsControl ItemsSource="{Binding Weekdays}" Margin="0,0,0,4">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type models:DayOfWeekCheckItem}">
                                        <ToggleButton IsChecked="{Binding IsSelected}" Margin="0,0,6,6" BorderThickness="0">
                                            <ToggleButton.Template>
                                                <ControlTemplate TargetType="ToggleButton">
                                                    <Border CornerRadius="6" Padding="12,7" Cursor="Hand">
                                                        <Border.Style>
                                                            <Style TargetType="Border">
                                                                <Setter Property="Background" Value="#F0F0F0" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsChecked, RelativeSource={RelativeSource AncestorType=ToggleButton}}" Value="True">
                                                                        <Setter Property="Background" Value="#104C7F" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Border.Style>
                                                        <TextBlock Text="{Binding ShortLabel}" FontSize="12" FontWeight="SemiBold">
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock">
                                                                    <Setter Property="Foreground" Value="#555555" />
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsChecked, RelativeSource={RelativeSource AncestorType=ToggleButton}}" Value="True">
                                                                            <Setter Property="Foreground" Value="White" />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>
                                                    </Border>
                                                </ControlTemplate>
                                            </ToggleButton.Template>
                                        </ToggleButton>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock Text="{Binding ValidationErrors[Weekdays]}" FontSize="11" Foreground="#D32F2F" Margin="0,0,0,12" Visibility="{Binding ValidationErrors[Weekdays], Converter={StaticResource StringToVisibilityConverter}}" />

                            <!-- Schedule Dates -->
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                    <TextBlock Text="Start Date" FontSize="12" Foreground="#555555" FontWeight="Medium" Margin="0,0,0,4" />
                                    <DatePicker SelectedDate="{Binding SelectedStartDate}" Padding="8,6" Background="#F8F9FA" BorderBrush="#E0E0E0" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                    <TextBlock Text="End Date" FontSize="12" Foreground="#555555" FontWeight="Medium" Margin="0,0,0,4" />
                                    <DatePicker SelectedDate="{Binding SelectedEndDate}" Padding="8,6" Background="#F8F9FA" BorderBrush="#E0E0E0">
                                        <DatePicker.Style>
                                            <Style TargetType="DatePicker">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsOngoingReminder}" Value="True">
                                                        <Setter Property="IsEnabled" Value="False" />
                                                        <Setter Property="Opacity" Value="0.45" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </DatePicker.Style>
                                    </DatePicker>
                                </StackPanel>
                            </Grid>
                            <CheckBox Content="Ongoing medication — no end date" IsChecked="{Binding IsOngoingReminder}" Foreground="#555555" Margin="0,0,0,16" />

                            <CheckBox Content="Enabled" IsChecked="{Binding IsReminderEnabled}" Foreground="#555555" Margin="0,0,0,20" />

                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button Content="Cancel" Command="{Binding ClosePopupCommand}" Background="Transparent" Foreground="#666666" Padding="12,8" Margin="0,0,8,0" BorderThickness="0" />
                                <Button Content="Save Reminder" Command="{Binding SaveReminderCommand}" Background="#104C7F" Foreground="White" Padding="16,8" BorderThickness="0">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
