<UserControl x:Class="MediTrack.UI.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:MediTrack.UI.Converters"
             xmlns:models="clr-namespace:MediTrack.UI.Models">
    <UserControl.Resources>
        <conv:StringToVisibilityConverter x:Key="StringToVisibilityConverter" />
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
        <conv:InvertedBooleanToVisibilityConverter x:Key="InvertedBoolToVisibility" />
        <Style x:Key="NavItemStyle" TargetType="Border">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Padding" Value="16,10" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Cursor" Value="Hand" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                    <Setter Property="Background" Value="#1565C0" />
                </DataTrigger>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#1565C0" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="ToggleSwitch" TargetType="ToggleButton">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border Width="48" Height="26" CornerRadius="13">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Background" Value="#E0E0E0" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsChecked, RelativeSource={RelativeSource AncestorType=ToggleButton}}" Value="True">
                                            <Setter Property="Background" Value="#4CAF50" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <Ellipse Width="20" Height="20" Fill="White" Margin="3,0">
                                <Ellipse.Style>
                                    <Style TargetType="Ellipse">
                                        <Setter Property="HorizontalAlignment" Value="Left" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsChecked, RelativeSource={RelativeSource AncestorType=ToggleButton}}" Value="True">
                                                <Setter Property="HorizontalAlignment" Value="Right" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Ellipse.Style>
                            </Ellipse>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="CardButton" TargetType="Button">
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="240" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Sidebar -->
        <Grid Grid.Column="0" Background="#104C7F">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <StackPanel Grid.Row="0" Margin="24,24,24,16" Orientation="Horizontal">
                <Image Source="/Assets/logo-meditrack.png" Width="40" Height="40" Margin="0,0,10,0" VerticalAlignment="Top" />
                <StackPanel>
                    <TextBlock Text="MediTrack" FontSize="24" FontWeight="Bold" Foreground="White" />
                    <TextBlock Text="Reminder" FontSize="14" Foreground="#90CAF9" />
                </StackPanel>
            </StackPanel>
            <ListBox Grid.Row="1" ItemsSource="{Binding NavItems}" SelectedItem="{Binding SelectedNavItem}" Background="Transparent" BorderThickness="0" Margin="12,0">
                <ListBox.ItemTemplate>
                    <DataTemplate DataType="{x:Type models:NavItem}">
                        <Border Style="{StaticResource NavItemStyle}">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{Binding Icon}" Fill="White" Width="16" Height="16" Stretch="Uniform" Margin="0,0,12,0" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding Label}" Foreground="White" FontSize="14" VerticalAlignment="Center" />
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
            <Border Grid.Row="2" Background="#0D3A66" Padding="16" Margin="12,0,12,12" CornerRadius="8">
                <StackPanel>
                    <TextBlock Text="{Binding WelcomeMessage}" FontSize="12" Foreground="#BBDEFB" TextTrimming="CharacterEllipsis" />
                    <Button Command="{Binding LogoutCommand}" Background="Transparent" Foreground="White" FontSize="12" HorizontalAlignment="Left" Padding="0" Margin="0,4,0,0" BorderThickness="0">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="M17,7L15.59,8.41L18.17,11H8V13H18.17L15.59,15.58L17,17L22,12M12,2A10,10 0 0,0 2,12A10,10 0 0,0 12,22A10,10 0 0,0 22,12V20H20V12A8,8 0 0,1 12,4A8,8 0 0,1 20,12V18H18V12A6,6 0 0,0 12,6A6,6 0 0,0 6,12V18H4V12A8,8 0 0,1 12,4" Fill="White" Width="14" Height="14" Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center" />
                            <TextBlock Text="Logout" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Main Content -->
        <Grid Grid.Column="1" Background="#F8F9FA">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Top Bar -->
            <Border Grid.Row="0" Background="White" Padding="24,16" Margin="0,0,0,1">
                <Border.Effect><DropShadowEffect ShadowDepth="0" BlurRadius="4" Opacity="0.06" Color="#000000" /></Border.Effect>
                <StackPanel>
                    <TextBlock Text="Settings" FontSize="22" FontWeight="Bold" Foreground="#1A1A1A" />
                    <TextBlock Text="Manage your account and preferences" FontSize="13" Foreground="#888888" Margin="0,2,0,0" />
                </StackPanel>
            </Border>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="24">
                <StackPanel MaxWidth="640" HorizontalAlignment="Left">

                    <!-- Account Card -->
                    <Border Background="White" CornerRadius="12" Padding="24" Margin="0,0,0,20">
                        <Border.Effect><DropShadowEffect ShadowDepth="0" BlurRadius="12" Opacity="0.06" Color="#000000" /></Border.Effect>
                        <StackPanel>
                            <TextBlock Text="Account" FontSize="16" FontWeight="SemiBold" Foreground="#1A1A1A" Margin="0,0,0,16" />

                            <!-- Display Mode -->
                            <Grid Visibility="{Binding IsEditingProfile, Converter={StaticResource InvertedBoolToVisibility}}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Width="56" Height="56" CornerRadius="28" Background="#104C7F" Margin="0,0,16,0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding UserInitial}" FontSize="22" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding UserFullName}" FontSize="16" FontWeight="SemiBold" Foreground="#1A1A1A" />
                                    <TextBlock Text="{Binding UserEmail}" FontSize="13" Foreground="#888888" Margin="0,3,0,0" />
                                    <TextBlock Text="{Binding UserName}" FontSize="12" Foreground="#AAAAAA" Margin="0,2,0,0" />
                                </StackPanel>
                                <Button Grid.Column="2" Content="Edit Profile" Command="{Binding EditProfileCommand}"
                                        Background="#E3F2FD" Foreground="#104C7F" Padding="12,8" FontSize="13" FontWeight="SemiBold"
                                        Style="{StaticResource CardButton}" VerticalAlignment="Center" />
                            </Grid>

                            <!-- Edit Mode -->
                            <StackPanel Visibility="{Binding IsEditingProfile, Converter={StaticResource BoolToVisibility}}">
                                <TextBlock Text="Full Name" FontSize="12" Foreground="#555555" FontWeight="Medium" Margin="0,0,0,4" />
                                <TextBox Text="{Binding EditFullName, UpdateSourceTrigger=PropertyChanged}" Padding="10,9" Background="#F8F9FA" BorderBrush="#E0E0E0" BorderThickness="1" FontSize="14" Margin="0,0,0,12" />
                                <TextBlock Text="Email Address" FontSize="12" Foreground="#555555" FontWeight="Medium" Margin="0,0,0,4" />
                                <TextBox Text="{Binding EditEmail, UpdateSourceTrigger=PropertyChanged}" Padding="10,9" Background="#F8F9FA" BorderBrush="#E0E0E0" BorderThickness="1" FontSize="14" Margin="0,0,0,12" />
                                <TextBlock Text="Username" FontSize="12" Foreground="#555555" FontWeight="Medium" Margin="0,0,0,4" />
                                <TextBox Text="{Binding UserName}" IsReadOnly="True" Padding="10,9" Background="#F5F5F5" BorderBrush="#E0E0E0" BorderThickness="1" FontSize="14" Margin="0,0,0,12" Foreground="#888888" />
                                <TextBlock Text="{Binding ProfileErrorMessage}" Foreground="#D32F2F" FontSize="12" Margin="0,0,0,8"
                                           Visibility="{Binding ProfileErrorMessage, Converter={StaticResource StringToVisibilityConverter}}" />
                                <TextBlock Text="{Binding ProfileSuccessMessage}" Foreground="#2E7D32" FontSize="12" Margin="0,0,0,8"
                                           Visibility="{Binding ProfileSuccessMessage, Converter={StaticResource StringToVisibilityConverter}}" />
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                    <Button Content="Cancel" Command="{Binding CancelEditProfileCommand}"
                                            Background="#F5F5F5" Foreground="#555555" Padding="14,8" FontSize="13" Margin="0,0,8,0"
                                            Style="{StaticResource CardButton}" />
                                    <Button Content="Save Changes" Command="{Binding SaveProfileCommand}"
                                            Background="#104C7F" Foreground="White" Padding="14,8" FontSize="13" FontWeight="SemiBold"
                                            Style="{StaticResource CardButton}" />
                                </StackPanel>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Preferences Card -->
                    <Border Background="White" CornerRadius="12" Padding="24" Margin="0,0,0,20">
                        <Border.Effect><DropShadowEffect ShadowDepth="0" BlurRadius="12" Opacity="0.06" Color="#000000" /></Border.Effect>
                        <StackPanel>
                            <TextBlock Text="Preferences" FontSize="16" FontWeight="SemiBold" Foreground="#1A1A1A" Margin="0,0,0,16" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                    <TextBlock Text="Sound Notifications" FontSize="14" FontWeight="Medium" Foreground="#1A1A1A" />
                                    <TextBlock Text="Play a sound when a reminder fires" FontSize="12" Foreground="#888888" Margin="0,2,0,0" />
                                </StackPanel>
                                <ToggleButton Grid.Column="1" IsChecked="{Binding SoundEnabled}" Style="{StaticResource ToggleSwitch}" VerticalAlignment="Center" />
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Security Card -->
                    <Border Background="White" CornerRadius="12" Padding="24" Margin="0,0,0,20">
                        <Border.Effect><DropShadowEffect ShadowDepth="0" BlurRadius="12" Opacity="0.06" Color="#000000" /></Border.Effect>
                        <StackPanel>
                            <TextBlock Text="Security" FontSize="16" FontWeight="SemiBold" Foreground="#1A1A1A" Margin="0,0,0,16" />

                            <!-- Display Mode -->
                            <Grid Visibility="{Binding IsChangingPassword, Converter={StaticResource InvertedBoolToVisibility}}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                    <TextBlock Text="Password" FontSize="14" FontWeight="Medium" Foreground="#1A1A1A" />
                                    <TextBlock Text="Change your account password" FontSize="12" Foreground="#888888" Margin="0,2,0,0" />
                                </StackPanel>
                                <Button Grid.Column="1" Content="Change Password" Command="{Binding ShowChangePasswordCommand}"
                                        Background="#E3F2FD" Foreground="#104C7F" Padding="12,8" FontSize="13" FontWeight="SemiBold"
                                        Style="{StaticResource CardButton}" VerticalAlignment="Center" />
                            </Grid>

                            <!-- Edit Mode -->
                            <StackPanel Visibility="{Binding IsChangingPassword, Converter={StaticResource BoolToVisibility}}">
                                <TextBlock Text="Current Password" FontSize="12" Foreground="#555555" FontWeight="Medium" Margin="0,0,0,4" />
                                <PasswordBox x:Name="CurrentPasswordBox" Padding="10,9" Background="#F8F9FA" BorderBrush="#E0E0E0" BorderThickness="1" FontSize="14" Margin="0,0,0,12" PasswordChanged="CurrentPasswordBox_PasswordChanged" />
                                <TextBlock Text="New Password" FontSize="12" Foreground="#555555" FontWeight="Medium" Margin="0,0,0,4" />
                                <PasswordBox x:Name="NewPasswordBox" Padding="10,9" Background="#F8F9FA" BorderBrush="#E0E0E0" BorderThickness="1" FontSize="14" Margin="0,0,0,12" PasswordChanged="NewPasswordBox_PasswordChanged" />
                                <TextBlock Text="Confirm New Password" FontSize="12" Foreground="#555555" FontWeight="Medium" Margin="0,0,0,4" />
                                <PasswordBox x:Name="ConfirmPasswordBox" Padding="10,9" Background="#F8F9FA" BorderBrush="#E0E0E0" BorderThickness="1" FontSize="14" Margin="0,0,0,12" PasswordChanged="ConfirmPasswordBox_PasswordChanged" />
                                <TextBlock Text="{Binding PasswordErrorMessage}" Foreground="#D32F2F" FontSize="12" Margin="0,0,0,8"
                                           Visibility="{Binding PasswordErrorMessage, Converter={StaticResource StringToVisibilityConverter}}" />
                                <TextBlock Text="{Binding PasswordSuccessMessage}" Foreground="#2E7D32" FontSize="12" Margin="0,0,0,8"
                                           Visibility="{Binding PasswordSuccessMessage, Converter={StaticResource StringToVisibilityConverter}}" />
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                    <Button Content="Cancel" Command="{Binding CancelChangePasswordCommand}"
                                            Background="#F5F5F5" Foreground="#555555" Padding="14,8" FontSize="13" Margin="0,0,8,0"
                                            Style="{StaticResource CardButton}" />
                                    <Button Content="Update Password" Command="{Binding SavePasswordCommand}"
                                            Background="#104C7F" Foreground="White" Padding="14,8" FontSize="13" FontWeight="SemiBold"
                                            Style="{StaticResource CardButton}" />
                                </StackPanel>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- About Card -->
                    <Border Background="White" CornerRadius="12" Padding="24">
                        <Border.Effect><DropShadowEffect ShadowDepth="0" BlurRadius="12" Opacity="0.06" Color="#000000" /></Border.Effect>
                        <StackPanel>
                            <TextBlock Text="About" FontSize="16" FontWeight="SemiBold" Foreground="#1A1A1A" Margin="0,0,0,16" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="MediTrack Version" FontSize="14" Foreground="#1A1A1A" VerticalAlignment="Center" />
                                <Border Grid.Column="1" Background="#E3F2FD" CornerRadius="6" Padding="8,4">
                                    <TextBlock Text="{Binding AppVersion}" FontSize="13" Foreground="#104C7F" FontWeight="SemiBold" />
                                </Border>
                            </Grid>
                        </StackPanel>
                    </Border>

                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>
