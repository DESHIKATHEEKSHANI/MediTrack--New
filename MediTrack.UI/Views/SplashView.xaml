<UserControl x:Class="MediTrack.UI.Views.SplashView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:MediTrack.UI.ViewModels"
             Background="#104C7F">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Top decorative circle -->
        <Ellipse Grid.Row="0" Width="200" Height="200" Fill="#1A5C94" Opacity="0.3" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="-60,-60,0,0" />
        <Ellipse Grid.Row="0" Width="140" Height="140" Fill="#1A5C94" Opacity="0.2" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-40,-20,0" />
        <Ellipse Grid.Row="2" Width="180" Height="180" Fill="#1A5C94" Opacity="0.25" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,-40,-40" />
        <Ellipse Grid.Row="2" Width="100" Height="100" Fill="#1A5C94" Opacity="0.15" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="20,0,0,-20" />

        <!-- Center Content -->
        <StackPanel Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center">
            <!-- Logo -->
            <Image Source="/Assets/logo-meditrack.png" Width="120" Height="120" HorizontalAlignment="Center" Margin="0,0,0,20" />

            <TextBlock Text="MediTrack" FontSize="42" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" />
            <TextBlock Text="Reminder" FontSize="28" FontWeight="Light" Foreground="#90CAF9" HorizontalAlignment="Center" Margin="0,-8,0,0" />

            <TextBlock Text="Loading your health companion..." FontSize="14" Foreground="#BBDEFB" HorizontalAlignment="Center" Margin="0,10,0,20" />

            <!-- Spinner -->
            <Border HorizontalAlignment="Center" Width="280" Height="4" Background="#1A5C94" CornerRadius="2">
                <Rectangle Fill="White" Width="80" Height="4" RadiusX="2" RadiusY="2">
                    <Rectangle.RenderTransform>
                        <TranslateTransform X="0" />
                    </Rectangle.RenderTransform>
                    <Rectangle.Triggers>
                        <EventTrigger RoutedEvent="Loaded">
                            <BeginStoryboard>
                                <Storyboard RepeatBehavior="Forever">
                                    <DoubleAnimation Storyboard.TargetProperty="RenderTransform.(TranslateTransform.X)"
                                                     From="0" To="200" Duration="0:0:1.5" />
                                </Storyboard>
                            </BeginStoryboard>
                        </EventTrigger>
                    </Rectangle.Triggers>
                </Rectangle>
            </Border>

            <TextBlock Text="{Binding StatusMessage}" FontSize="12" Foreground="#90CAF9" HorizontalAlignment="Center" Margin="0,8,0,0" Opacity="0.8" />
        </StackPanel>
    </Grid>
</UserControl>
